# Local development defaults. Copy this file to .env at the repository root.
# These values are placeholders for a database that only listens on your machine.
# Do not reuse them outside local development.

# NestJS
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Next.js. Only NEXT_PUBLIC_ variables are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL, read by Docker Compose and by the API. The web app does not use them.
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=signaldesk
POSTGRES_DB=signaldesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://signaldesk:signaldesk@localhost:5432/signaldesk

# Minutes used to attach a new event to an open incident of the same service and error type.
EVENT_CORRELATION_WINDOW_MINUTES=30

# OpenAI. The key stays on the API. Leave it empty until you add one to the local .env.
# Do not put the key in a NEXT_PUBLIC_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_REASONING_EFFORT=none

# Global analysis cap for the whole API. It is not a per-user limit: there is no authentication.
# A public deployment must not rely on this alone.
ANALYSIS_RATE_LIMIT=10
ANALYSIS_RATE_WINDOW_MS=60000

# New Relic APM for the API process only. Leave it disabled until you add a license key.
# Put the key in the local .env. Do not commit it or copy it into a NEXT_PUBLIC_ variable.
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=SignalDesk-API
NEW_RELIC_LICENSE_KEY=
