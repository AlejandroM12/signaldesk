# Local development defaults. Copy this file to .env at the repository root.
# These values are placeholders for a database that only listens on your machine.
# Do not reuse them outside local development.

# NestJS
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Next.js. Only NEXT_PUBLIC_ variables are exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL, read by Docker Compose and by the API. The web app does not use them.
POSTGRES_USER=signaldesk
POSTGRES_PASSWORD=signaldesk
POSTGRES_DB=signaldesk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://signaldesk:signaldesk@localhost:5432/signaldesk
