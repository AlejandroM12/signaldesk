{
  "name": "signaldesk",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "pnpm --filter @signaldesk/contracts build && pnpm run --parallel --filter @signaldesk/web --filter @signaldesk/api dev",
    "dev:web": "pnpm --filter @signaldesk/contracts build && pnpm --filter @signaldesk/web dev",
    "dev:api": "pnpm --filter @signaldesk/contracts build && pnpm --filter @signaldesk/api dev",
    "build": "pnpm run -r build",
    "lint": "pnpm run -r lint",
    "test": "pnpm --filter @signaldesk/api test",
    "test:e2e": "pnpm --filter @signaldesk/api test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @signaldesk/api db:generate",
    "db:migrate": "pnpm --filter @signaldesk/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @signaldesk/api db:migrate:deploy",
    "db:seed": "pnpm --filter @signaldesk/api db:seed"
  }
}
